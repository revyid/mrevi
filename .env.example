# ============================================================
# mrevi — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================

# --- Supabase (server) ---
# lib/db.ts uses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
# The service-role key bypasses RLS — server-side only, NEVER expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (client) ---
# Used by lib/db.ts (server), lib/supabase-client.ts (browser) and proxy.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth ---
# Secret used to sign session JWTs (lib/auth.ts, proxy.ts). Use a long random string.
JWT_SECRET=

# --- OAuth (Google) ---
# Server-side token exchange (app/auth/callback, app/api/auth/*).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client-side OAuth initiation (components/auth/AuthForm.tsx).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- OAuth (GitHub) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- Cloudinary (app/api/assets uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Public URLs ---
# Canonical site origin (falls back to https://www.revy.my.id).
NEXT_PUBLIC_BASE_URL=
# External API (mrevi-api) base URL (falls back to https://api.revy.my.id).
NEXT_PUBLIC_API_URL=
# External auth API base URL (falls back to https://api.revy.my.id).
NEXT_PUBLIC_AUTH_URL=
# Auth API base URL used by lib/api-client.ts (falls back to NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_AUTH_API_URL=

# --- Optional debug flags ---
# Set to "true" to enable verbose auth logging outside development.
# AUTH_DEBUG=
# NEXT_PUBLIC_AUTH_DEBUG=
